<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/splash_gradient">
    <include
        android:id="@+id/xml_toolbar"
        layout="@layout/toolbar"
        android:elevation="4dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>
    <ImageView
        android:id="@+id/view_image"
        android:layout_width="wrap_content"
        android:layout_height="480dp"
        android:adjustViewBounds="true"
        android:scaleType="fitCenter"
        app:layout_constraintDimensionRatio="16:9"
        android:layout_marginTop="16dp"
        android:layout_marginBottom="16dp"
        android:contentDescription="Image to edit"
        app:layout_constraintWidth_percent="1.0"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@id/xml_toolbar"
        app:layout_constraintBottom_toTopOf="@id/button_container" />

    <LinearLayout
        android:id="@+id/button_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center"
        android:padding="16dp"
        app:elevation="4dp"
        app:layout_constraintBottom_toTopOf="@id/after_rotate_container"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/delicon"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="16dp"
            android:text="Delete"
            android:textSize="14sp"
            android:padding="12dp"
            android:contentDescription="Delete image"
            app:icon="@drawable/discard"
            app:iconGravity="start"
            app:iconPadding="8dp"
            app:cornerRadius="8dp"
            app:backgroundTint="@color/purple_100"
            style="@style/Widget.Material3.Button.ElevatedButton" />

        <!-- Crop Button -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/cropicon"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="16dp"
            android:text="Crop"
            android:textSize="14sp"
            android:padding="12dp"
            android:contentDescription="Crop image"
            app:icon="@drawable/crop_btn"
            app:iconGravity="start"
            app:iconPadding="8dp"
            app:cornerRadius="8dp"
            app:backgroundTint="@color/purple_100"
            style="@style/Widget.Material3.Button.ElevatedButton" />

        <!-- Rotate Button -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/rotateicon"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Rotate"
            android:textSize="14sp"
            android:padding="12dp"
            android:contentDescription="Rotate image"
            app:icon="@drawable/rotate_icon"
            app:iconGravity="start"
            app:iconPadding="8dp"
            app:cornerRadius="8dp"
            app:backgroundTint="@color/purple_100"
            style="@style/Widget.Material3.Button.ElevatedButton" />

    </LinearLayout>


    <LinearLayout
        android:id="@+id/after_rotate_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="?attr/colorSurface"
        android:orientation="horizontal"
        android:gravity="center"
        android:padding="16dp"
        app:elevation="4dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <!-- Save Button -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/save_rimage"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="16dp"
            android:text="Save"
            android:textSize="14sp"
            android:padding="12dp"
            android:contentDescription="Save rotated image"
            app:cornerRadius="8dp"
            app:backgroundTint="@color/purple_100"
            style="@style/Widget.Material3.Button.ElevatedButton" />

        <!-- Discard Button -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/discard_image"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Discard"
            android:textSize="14sp"
            android:padding="12dp"
            android:contentDescription="Discard rotated image"
            app:cornerRadius="8dp"
            app:backgroundTint="@color/purple_100"
            style="@style/Widget.Material3.Button.OutlinedButton" />

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>