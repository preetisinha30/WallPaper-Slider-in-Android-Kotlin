<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/splash_gradient"
    android:fitsSystemWindows="true">

    <!-- Toolbar at the top -->
    <include
        android:id="@+id/xml_toolbar"
        layout="@layout/toolbar"
        android:elevation="4dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <!-- ImageView set to cover the entire available space below the toolbar -->
    <ImageView
        android:id="@+id/view_image"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:adjustViewBounds="true"
        android:scaleType="centerCrop"
        android:contentDescription="Image to edit"
        android:background="@color/purple_200"
        app:layout_constraintTop_toBottomOf="@id/xml_toolbar"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/> <!-- Added a temporary background for visibility if image fails to load -->

    <ImageView
        android:id="@+id/view_category_indicator"
        android:layout_width="64dp"
        android:layout_height="64dp"
        android:layout_marginTop="4dp"
        android:layout_marginEnd="4dp"
        android:scaleType="centerInside"
        android:padding="4dp"
        android:background="@drawable/category_indicator_background"
        android:contentDescription="Category indicator"
        android:elevation="4dp"
        app:layout_constraintTop_toTopOf="@id/view_image"
        app:layout_constraintEnd_toEndOf="@id/view_image" />

    <!-- Button Container (Delete, Crop, Rotate) -->
    <!-- Positioned above 'after_rotate_container' and centered horizontally -->
    <LinearLayout
        android:id="@+id/button_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center"
        android:padding="16dp"
        android:elevation="4dp"
        app:layout_constraintBottom_toTopOf="@id/after_rotate_container"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/delicon"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="16dp"
            android:text="Delete"
            android:textSize="14sp"
            android:padding="12dp"
            android:contentDescription="Delete image"
            app:icon="@drawable/discard"
            app:iconGravity="start"
            app:iconPadding="8dp"
            app:cornerRadius="8dp"
            app:backgroundTint="@color/purple_100"
            style="@style/Widget.Material3.Button.ElevatedButton" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/cropicon"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="16dp"
            android:text="Crop"
            android:textSize="14sp"
            android:padding="12dp"
            android:contentDescription="Crop image"
            app:icon="@drawable/crop_btn"
            app:iconGravity="start"
            app:iconPadding="8dp"
            app:cornerRadius="8dp"
            app:backgroundTint="@color/purple_100"
            style="@style/Widget.Material3.Button.ElevatedButton" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/rotateicon"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Rotate"
            android:textSize="14sp"
            android:padding="12dp"
            android:contentDescription="Rotate image"
            app:icon="@drawable/rotate_icon"
            app:iconGravity="start"
            app:iconPadding="8dp"
            app:cornerRadius="8dp"
            app:backgroundTint="@color/purple_100"
            style="@style/Widget.Material3.Button.ElevatedButton" />

    </LinearLayout>

    <!-- After Rotate Container (Save, Discard) -->
    <!-- Positioned at the very bottom of the parent -->
    <LinearLayout
        android:id="@+id/after_rotate_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center"
        android:padding="16dp"
        android:elevation="4dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/save_rimage"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="16dp"
            android:text="Save"
            android:textSize="14sp"
            android:padding="12dp"
            android:contentDescription="Save rotated image"
            app:cornerRadius="8dp"
            app:backgroundTint="@color/purple_100"
            style="@style/Widget.Material3.Button.ElevatedButton" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/discard_image"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Discard"
            android:textSize="14sp"
            android:padding="12dp"
            android:contentDescription="Discard rotated image"
            app:cornerRadius="8dp"
            app:backgroundTint="@color/purple_100"
            style="@style/Widget.Material3.Button.OutlinedButton" />

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>

