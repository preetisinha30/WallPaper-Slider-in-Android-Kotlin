<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/splash_gradient">
    <include
        android:id="@+id/xml_toolbar"
        layout="@layout/toolbar"
        android:elevation="4dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>
    <!-- Before Crop Container -->
    <LinearLayout
        android:id="@+id/lv_beforecrop"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:gravity="center"
        android:padding="16dp"
        app:elevation="4dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/xml_toolbar">



    <com.np.wallpaperslider.CropImageView
        android:id="@+id/cv4"
        android:layout_width="wrap_content"
        android:layout_height="480dp"
        android:background="@android:color/transparent"
        app:layout_constraintBottom_toTopOf="@id/crop_image"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        android:layout_marginTop="16dp"
        android:layout_marginBottom="16dp"
        android:contentDescription="Select Image area"/>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/crop_image"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="Click Here to Select Image"
            android:textSize="14sp"
            android:contentDescription="Select image to crop"
            app:cornerRadius="8dp"
            app:backgroundTint="@color/purple_100"
            app:layout_constraintTop_toBottomOf="@id/cv4"
            style="@style/Widget.Material3.Button.ElevatedButton"/>

</LinearLayout>
    <LinearLayout
        android:id="@+id/lv_aftercrop"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:gravity="center"
        android:padding="16dp"
        app:elevation="4dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/xml_toolbar">


    <ImageView
            android:id="@+id/set_image"
            android:layout_width="wrap_content"
            android:layout_height="480dp"
            android:adjustViewBounds="true"
            android:scaleType="fitCenter"
            app:layout_constraintDimensionRatio="16:9"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintBottom_toTopOf="@id/save_image"
            android:layout_marginTop="16dp"
            android:layout_marginBottom="16dp"
            android:contentDescription="Cropped image preview"
            />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/save_image"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="Save Image"
            android:textSize="14sp"
            android:contentDescription="Save cropped image"
            app:cornerRadius="8dp"
            app:backgroundTint="@color/purple_100"
            style="@style/Widget.Material3.Button.ElevatedButton" />


    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>