<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/splash_gradient"
    tools:context=".MainActivity">

    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/guide_left"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        app:layout_constraintGuide_percent="0.08" />

    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/guide_right"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        app:layout_constraintGuide_percent="0.92" />

    <!-- Welcome Text -->
    <TextView
        android:id="@+id/welcome_text"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="@string/welcome_text"
        android:textAlignment="center"
        android:textSize="30sp"
        android:textColor="@color/blue_200"
        android:fontFamily="sans-serif-medium"
        android:layout_marginBottom="8dp"
        app:layout_constraintBottom_toTopOf="@id/subtitle_text"
        app:layout_constraintStart_toStartOf="@id/guide_left"
        app:layout_constraintEnd_toEndOf="@id/guide_right"
        android:background="@null"/>

    <!-- Subtitle TextView -->
    <TextView
        android:id="@+id/subtitle_text"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="@string/subtitle_text"
        android:textAlignment="center"
        android:textColor="@color/blue_200"
        android:textSize="14sp"
        android:fontFamily="sans-serif"
        android:layout_marginBottom="20dp"
        android:contentDescription="Subtitle: Explore our features"
        app:layout_constraintBottom_toTopOf="@id/logoimg"
        app:layout_constraintStart_toStartOf="@id/guide_left"
        app:layout_constraintEnd_toEndOf="@id/guide_right"
        android:background="@null"/>

    <!-- App Logo -->
    <ImageView
        android:id="@+id/logoimg"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:src="@drawable/image"
        android:contentDescription="App logo"
        app:layout_constraintDimensionRatio="1:1"
        app:layout_constraintWidth_percent="0.6"
        app:layout_constraintWidth_max="320dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toTopOf="@id/fitscreenicon"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintVertical_bias="0.45" />

    <!-- Login Button with Icon -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/fitscreenicon"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginEnd="8dp"
        android:layout_marginBottom="40dp"
        android:text="Add Image"
        android:contentDescription="Add Image to Slide"
        app:icon="@drawable/baseline_add_a_photo_24"
        app:layout_constraintWidth_max="250dp"
        app:layout_constraintHorizontal_chainStyle="packed"
        app:layout_constraintStart_toStartOf="@id/guide_left"
        app:layout_constraintEnd_toStartOf="@id/cropscreenicon"
        app:layout_constraintBottom_toBottomOf="parent"
        style="@style/AppButton.Primary" />

    <!-- Sign Up Button with Icon -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/cropscreenicon"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:layout_marginBottom="40dp"
        android:text="My Images"
        android:contentDescription="Collection of My Images"
        app:icon="@drawable/baseline_collections_24"
        app:layout_constraintWidth_max="250dp"
        app:layout_constraintStart_toEndOf="@id/fitscreenicon"
        app:layout_constraintEnd_toEndOf="@id/guide_right"
        app:layout_constraintBottom_toBottomOf="parent"
        style="@style/AppButton.Primary" />

</androidx.constraintlayout.widget.ConstraintLayout>
