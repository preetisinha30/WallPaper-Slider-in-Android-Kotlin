<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/splash_gradient">

    <!-- MaterialToolbar -->
    <include
        android:id="@+id/xml_toolbar"
        layout="@layout/toolbar"
        android:elevation="4dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <!-- SurfaceView for Live Wallpaper Preview -->
    <SurfaceView
        android:id="@+id/wallpaper_preview"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:contentDescription="Live wallpaper preview"
        app:layout_constraintWidth_percent="1.0"
        app:layout_constraintDimensionRatio="4:3"
        app:layout_constraintTop_toBottomOf="@id/xml_toolbar"
        app:layout_constraintBottom_toTopOf="@id/button_container"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintVertical_bias="0.3" />

    <!-- Button Container -->
    <LinearLayout
        android:id="@+id/button_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center"
        android:padding="16dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <!-- Cancel Button -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/cancel_button"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="16dp"
            android:text="Cancel"
            android:textSize="14sp"
            android:padding="12dp"
            app:icon="@drawable/discard"
            android:contentDescription="Cancel wallpaper selection"
            app:cornerRadius="8dp"
            app:backgroundTint="@color/purple_100"
            style="@style/Widget.Material3.Button.OutlinedButton" />

        <!-- Preview Settings Button -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/settings_button"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="16dp"
            android:text="Settings"
            android:textSize="14sp"
            android:padding="12dp"
            android:contentDescription="Open wallpaper settings"
            app:cornerRadius="8dp"
            app:backgroundTint="@color/purple_100"
            app:icon="@android:drawable/ic_menu_preferences"
            app:iconGravity="start"
            app:iconPadding="8dp"
            style="@style/Widget.Material3.Button.ElevatedButton" />

        <!-- Set Wallpaper Button -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/set_wallpaper_button"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Set Wallpaper"
            android:textSize="14sp"
            android:padding="12dp"
            android:contentDescription="Set this wallpaper"
            app:cornerRadius="8dp"
            app:backgroundTint="@color/purple_100"
            app:icon="@android:drawable/ic_menu_set_as"
            app:iconGravity="start"
            app:iconPadding="8dp"
            style="@style/Widget.Material3.Button.ElevatedButton" />

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
