<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/splash_gradient"
    android:fitsSystemWindows="true">

    <!-- Toolbar -->
    <include
        android:id="@+id/xml_toolbar"
        layout="@layout/toolbar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:elevation="4dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Image Container -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/cl_imageContainer"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:padding="@dimen/margin_16dp"
        app:layout_constraintTop_toBottomOf="@id/xml_toolbar"
        app:layout_constraintBottom_toTopOf="@id/cl_actionButtons"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constrainedHeight="true">

        <!-- CropImageView -->
        <com.np.wallpaperslider.CropImageView
            android:id="@+id/cv4"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:scaleType="fitCenter"
            android:adjustViewBounds="true"
            android:background="@drawable/image_border"
            android:contentDescription="@string/desc_select_crop_area"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            android:layout_margin="@dimen/margin_16dp" />

        <!-- Preview ImageView -->
        <ImageView
            android:id="@+id/set_image"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:adjustViewBounds="true"
            android:scaleType="fitCenter"
            android:background="@drawable/image_border"
            android:contentDescription="@string/desc_cropped_preview"
            android:visibility="gone"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            android:layout_margin="@dimen/margin_16dp" />

    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- Action Buttons Container (Centered below Image) -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/cl_actionButtons"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:background="@drawable/action_buttons_background"
        android:padding="@dimen/margin_8dp"
        android:elevation="8dp"
        app:layout_constraintTop_toBottomOf="@id/cl_imageContainer"
        app:layout_constraintBottom_toTopOf="@id/cl_buttonContainer"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="@dimen/margin_8dp"
        android:layout_marginBottom="@dimen/margin_8dp">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/zoom_in"
            android:layout_width="@dimen/button_min_size"
            android:layout_height="@dimen/button_height_48dp"
            app:icon="@drawable/zoom_in_icon"
            android:contentDescription="@string/desc_zoom_in"
            app:cornerRadius="@dimen/button_radius"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            android:layout_marginEnd="@dimen/margin_8dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/zoom_out"
            android:layout_width="@dimen/button_min_size"
            android:layout_height="@dimen/button_height_48dp"
            app:icon="@drawable/zoom_out_icon"
            android:contentDescription="@string/desc_zoom_out"
            app:cornerRadius="@dimen/button_radius"
            app:layout_constraintStart_toEndOf="@id/zoom_in"
            app:layout_constraintTop_toTopOf="parent"
            android:layout_marginEnd="@dimen/margin_8dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/rot_icon"
            android:layout_width="@dimen/button_min_size"
            android:layout_height="@dimen/button_height_48dp"
            app:icon="@drawable/rotate_icon"
            android:contentDescription="@string/desc_rotate"
            app:cornerRadius="@dimen/button_radius"
            app:layout_constraintStart_toEndOf="@id/zoom_out"
            app:layout_constraintTop_toTopOf="parent"
            android:layout_marginEnd="@dimen/margin_8dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/undo_icon"
            android:layout_width="@dimen/button_min_size"
            android:layout_height="@dimen/button_height_48dp"
            app:icon="@drawable/undo_icon"
            android:contentDescription="@string/desc_undo"
            app:cornerRadius="@dimen/button_radius"
            app:layout_constraintStart_toEndOf="@id/rot_icon"
            app:layout_constraintTop_toTopOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- Button Container (Bottom of Screen) -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/cl_buttonContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="@dimen/margin_16dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <!-- Cancel Button (Bottom Left) -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/cancel_button"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/margin_16dp"
            android:text="@string/cancel"
            android:textSize="@dimen/text_size_button"
            android:padding="12dp"
            android:contentDescription="@string/desc_cancel"
            app:cornerRadius="@dimen/button_radius"
            app:backgroundTint="@color/purple_100"
            style="@style/Widget.Material3.Button.ElevatedButton"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent" />

        <!-- Crop Button (Bottom Right) -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/crop_image"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="@dimen/margin_16dp"
            android:text="@string/select_image"
            android:textSize="@dimen/text_size_button"
            android:padding="12dp"
            android:contentDescription="@string/desc_crop_image"
            app:icon="@drawable/crop_btn"
            app:iconGravity="start"
            app:iconPadding="8dp"
            app:cornerRadius="@dimen/button_radius"
            app:backgroundTint="@color/purple_100"
            style="@style/Widget.Material3.Button.ElevatedButton"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent" />

        <!-- Save Button (Bottom Right, replaces Crop Button) -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/save_image"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="@dimen/margin_16dp"
            android:text="@string/save_image"
            android:textSize="@dimen/text_size_button"
            android:padding="12dp"
            android:contentDescription="@string/desc_save_image"
            app:cornerRadius="@dimen/button_radius"
            app:backgroundTint="@color/purple_100"
            style="@style/Widget.Material3.Button.ElevatedButton"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            android:visibility="gone" />

    </androidx.constraintlayout.widget.ConstraintLayout>

</androidx.constraintlayout.widget.ConstraintLayout>